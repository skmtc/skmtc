{
  "imports":{
    "@babel/helper-validator-identifier": "npm:@babel/helper-validator-identifier@7.27.1",
    "@deno/dnt":"jsr:@deno/dnt@0.42.3",
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/fmt": "jsr:@std/fmt@^1.0.8",
    "@std/fs": "jsr:@std/fs@^1.0.7",
    "@std/http": "jsr:@std/http@^1.0.16",
    "@std/log": "jsr:@std/log@^0.224.6",
    "@std/path": "jsr:@std/path@^1.0.9",
    "@std/semver": "jsr:@std/semver@^1.0.5",
    "@std/testing": "jsr:@std/testing@^1.0.15",
    "ignore": "npm:ignore@7.0.5",
    "openapi-types": "npm:openapi-types@^12.1.3",
    "tiny-invariant":"npm:tiny-invariant@1.3.3",
    "valibot": "npm:valibot@1.1.0",
    "zod": "npm:zod@^4.0.14"
  },
  "unstable": ["kv", "worker-options"],
  "workspace": [
    "./cli",
    "./convert",
    "./core",
    "./lang-csharp",
    "./lang-go",
    "./lang-java",
    "./lang-kotlin",
    "./lang-php",
    "./lang-python",
    "./lang-rust",
    "./lang-typescript",
    "./mcp",
    "./openapi-down-convert",
    "./swagger2openapi",
    "./server",
    "./worker"
  ],
  "tasks": {
    "release": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run .scripts/release.ts",
    "test:watch": "deno test --allow-all --watch",
    "test:coverage": "deno test --allow-all --coverage=coverage",
    "coverage:report": "deno coverage coverage --lcov > coverage.lcov",
    "coverage:html": "deno coverage coverage --html",
    "verify-docs": "deno run --allow-read docs/verify-docs.ts && deno run --allow-read --allow-run docs/friction-log/verify-catalog.ts"
  }
} 