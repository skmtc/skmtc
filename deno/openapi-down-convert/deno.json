{
  "name": "@skmtc/openapi-down-convert",
  "version": "0.14.4",
  "exports": "./src/index.ts",
  "imports": {
    "@std/yaml/parse": "jsr:@std/yaml@^1.0.5/parse"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "deno.window", "dom", "es2020"]
  },
  "publish": {
    "exclude": [
      "cli.ts",
      "src/cli.ts",
      "test/",
      "jest.config.js",
      "prettier.config.js",
      "package-lock.json",
      "tsconfig.json",
      "node_modules/",
      ".git/"
    ]
  },
  "tasks": {
    "publish": "JSR_URL=https://jsr.skmtc.dev/ deno publish --allow-slow-types --allow-dirty --no-check --token=$JSR_AUTH_TOKEN",
    "publish:dry": "JSR_URL=https://jsr.skmtc.dev/ deno publish --dry-run --allow-slow-types --allow-dirty --no-check"
  }
}
