{
  "name": "@skmtc/server",
  "version": "0.3.1",
  "license": "Apache-2.0",
  "exports": {
    ".": "./mod.ts"
  },
  "imports": {
    "hono": "npm:hono@4.7.2",
    "@skmtc/core": "jsr:@skmtc/core@0.28.4",
    "@skmtc/convert": "jsr:@skmtc/convert@0.1.17",
    "@valibot/to-json-schema": "npm:@valibot/to-json-schema@1.3.0"
  },
  "tasks": {
    "publish": "deno publish --allow-slow-types --allow-dirty --no-check",
    "openapi": "deno run --allow-read --allow-write --allow-env --allow-sys scripts/generateOpenApi.ts",
    "openapi:check": "deno run --allow-read --allow-env --allow-sys scripts/generateOpenApi.ts --check"
  }
}
