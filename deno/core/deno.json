{
  "name": "@skmtc/core",
  "version": "0.0.966",
  "imports": {
    "@/": "./",
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/testing": "jsr:@std/testing@^1.0.8",
    "@std/log": "jsr:@std/log@^0.224.6",
    "@types/lodash-es": "npm:@types/lodash-es@4.17.12",
    "lodash-es/get": "npm:lodash-es@4.17.21/get.js",
    "lodash-es/set": "npm:lodash-es@4.17.21/set.js",
    "openapi-types": "npm:openapi-types@^12.1.3",
    "valibot": "npm:valibot@1.1.0"
  },
  "exports": {
    ".": "./mod.ts",
    "./Brand": "./types/Brand.ts",
    "./EnrichmentRequest": "./types/EnrichmentRequest.ts",
    "./GeneratorKeys": "./dsl/GeneratorKeys.ts",
    "./Manifest": "./types/Manifest.ts",
    "./Method": "./types/Method.ts",
    "./Modifiers": "./types/Modifiers.ts",
    "./Preview": "./types/Preview.ts",
    "./RefName": "./types/RefName.ts",
    "./Results": "./types/Results.ts",
    "./Settings": "./types/Settings.ts",
    "./DenoJson": "./types/DenoJson.ts",
    "./parseModuleName": "./helpers/parseModuleName.ts",
    "./Enrichments": "./types/Enrichments.ts",
    "./PrettierConfig": "./types/PrettierConfig.ts",
    "./strings": "./helpers/strings.ts",
    "./formatNumber": "./helpers/formatNumber.ts",
    "./isEmpty": "./helpers/isEmpty.ts",
    "./toResolvedArtifactPath": "./helpers/toResolvedArtifactPath.ts",
    "./TypeSystem": "./types/TypeSystem.ts",
    "./refFns": "./helpers/refFns.ts",
    "./dsl": "./dsl/mod.ts",
    "./generate": "./context/generateTypes.ts",
    "./parse": "./context/parseTypes.ts",
    "./oas": "./oas/mod.ts"
  },
  "tasks": {
    "publish": "deno task build && deno task publish:deno && deno task publish:npm",
    "build": "deno run -A .scripts/build-node.ts",
    "publish:deno": "deno publish --allow-dirty --token=$JSR_AUTH_TOKEN",
    "publish:deno:ga": "deno publish --allow-slow-types",
    "publish:npm": "cd ../../packages/core && npm publish",
    "docs": "deno doc --html --name=\"My library\" ./mod.ts",
    "docs:json": "deno doc --json --name=\"My library\" ./mod.ts > ../docs/src/docs.json",
    "test": "deno test --allow-all",
    "test:watch": "deno test --allow-all --watch",
    "test:coverage": "deno test --allow-all --coverage=coverage",
    "coverage:report": "deno coverage coverage --lcov > coverage.lcov",
    "coverage:html": "deno coverage coverage --html"
  },
  "compilerOptions": {
    "noImplicitAny": true
  },
  "test": {
    "exclude": [
      ".scripts/"
    ]
  }
}
