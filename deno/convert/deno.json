{
  "name": "@skmtc/convert",
  "version": "0.1.17",
  "license": "Apache-2.0",
  "imports": {
    "@skmtc/openapi-down-convert": "jsr:@skmtc/openapi-down-convert@0.14.8",
    "@skmtc/swagger2openapi": "jsr:@skmtc/swagger2openapi@0.1.3",
    "@std/yaml": "jsr:@std/yaml@^1.0.5",
    "openapi-types": "npm:openapi-types@^12.1.3"
  },
  "exports": {
    ".": "./mod.ts"
  },
  "tasks": {
    "publish": "deno publish --allow-slow-types --allow-dirty --no-check",
    "test": "deno test --allow-all --no-check",
    "test:watch": "deno test --allow-all --no-check --watch"
  },
  "compilerOptions": {
    "noImplicitAny": true
  }
}
