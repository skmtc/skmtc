{
  "name": "@skmtc/swagger2openapi",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "exports": {
    ".": "./mod.ts",
    "./converter": "./converter.ts"
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.0.9",
    "@std/yaml": "jsr:@std/yaml@^1.1.0",
    "ajv": "npm:ajv@^8.17.1",
    "ajv-draft-04": "npm:ajv-draft-04@^1.0.0",
    "ajv-formats": "npm:ajv-formats@^3.0.1",
    "ts-pattern": "npm:ts-pattern@^5.6.2"
  },
  "fmt": {
    "singleQuote": true,
    "semiColons": false,
    "lineWidth": 100
  },
  "tasks": {
    "test": "deno test --allow-read",
    "test:watch": "deno test --allow-read --watch",
    "publish": "deno publish --allow-dirty",
    "publish:dry": "deno publish --dry-run --allow-dirty"
  },
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "fixtures/"
    ]
  }
}
