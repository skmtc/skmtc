{
  "name": "@skmtc/lint-plugin",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "exports": {
    ".": "./mod.ts"
  },
  "tasks": {
    "publish": "deno publish --allow-slow-types --allow-dirty",
    "test": "deno test --allow-all"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.10"
  },
  "publish": {
    "exclude": ["**/*.test.ts", "src/test/"]
  }
}
