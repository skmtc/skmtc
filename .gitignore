# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

.envrc

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

logs/


# Emitted by Deno and not needed
package-lock.json
packages/core
packages/cli

deno/test-one

.mcp.json
.claude
.cursor

plans/

openapi.json
# The stack server's published contract IS a committed source artifact
# (generated by `deno task openapi`, served by createServer). JSR publish has no
# build step, so it must be tracked despite the blanket ignore above.
!deno/server/openapi.json

.skmtc

# Test fixture working directories (smoke tests build ephemeral
# project trees here so they live inside the workspace for proper
# resolution; everything in here is regenerated per test run).
deno/cli/tests/.fixtures/

notes/*

todo.txt
# Doc-test extraction dir (docs/doc-test.ts regenerates it per run)
# and scaffold-compile test temp dirs.
deno/docs/.doc-test/
deno/.scaffold-check-*/

# Design-hook caches (per-machine)
.impeccable/
**/.impeccable/
